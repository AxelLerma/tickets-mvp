# ===================================================================
# tickets-mvp — Variables de entorno
# ===================================================================
# Copia este archivo a `.env` (en la raíz del repositorio) y ajusta los
# valores antes de levantar el proyecto localmente o con Docker Compose.
#
# ¡IMPORTANTE: nunca subas `.env` a control de versiones! Contiene
# secretos y contraseñas. El archivo `.gitignore` ya lo ignora.
# `.env.example` sí se versiona como referencia documentada.
# ===================================================================

# --- Base de datos (PostgreSQL 15) ---
# POSTGRES_PASSWORD se usa también dentro de DATABASE_URL del backend.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-password-change-me
POSTGRES_DB=tickets
DATABASE_URL=postgresql://postgres:dev-password-change-me@localhost:5432/tickets

# --- Backend (Node.js 26 LTS, Express 5) ---
PORT=4000
# Genera un secreto fuerte para producción: openssl rand -base64 32
JWT_SECRET=dev-jwt-secret-change-me-in-production-minimo-32-caracteres
FRONTEND_URL=http://localhost:3000
STORAGE_DIR=storage
MAX_UPLOAD_MB=100
TICKET_COOLDOWN_SEG=10
TICKETS_POR_HORA=10
CAPACIDAD_BALANCEADO=4
CAPACIDAD_SATURADO=8
NODE_ENV=development

# --- Frontend (Next.js 16) ---
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
# URL pública del backend. En Docker Compose se resuelve como http://backend:4000.
API_URL=http://localhost:4000

# --- Correo saliente (Nodemailer SMTP, opcional en desarrollo) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Soporte IEEQ <soporte@ieeq.local>"